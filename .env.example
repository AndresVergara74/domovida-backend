# ============================================================
# DomoVida - Variables de entorno (PLANTILLA, sin valores reales)
# ============================================================
# Uso:
#   Windows (PowerShell):  copy .env.example .env
#   Linux / macOS:         cp .env.example .env
# Luego completa los valores en .env.
# ⚠️ El archivo .env real NUNCA se sube a GitHub (está en .gitignore).
# Todas las variables son opcionales: si se dejan vacías, el sistema
# funciona en modo local (SQLite) y sin autenticación, como en el modo borde.
# ============================================================

# ------------------------------------------------------------
# BACKEND (FastAPI)
# ------------------------------------------------------------
# Base de datos que usa Docker Compose. Vacío = SQLite dentro del volumen.
# Para usar Supabase: cadena de conexión PostgreSQL (Session Pooler).
#   postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres?sslmode=require
DOCKER_DATABASE_URL=

# Base de datos al ejecutar el backend sin Docker (uvicorn).
#   Modo borde (sin internet):  sqlite:///./domovida_offline.db
DATABASE_URL=sqlite:///./domovida.db

# Tópico de ntfy.sh al que se envían las notificaciones push del cuidador.
# Usa un nombre único y difícil de adivinar.
NTFY_TOPIC=

# PS-01: clave que deben enviar los sensores en la cabecera X-API-Key.
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacío = el backend acepta datos sin clave (solo para desarrollo).
DOMOVIDA_API_KEY=

# PS-01b: Supabase Auth para la sesión del cuidador (atender alertas).
# URL del proyecto y clave PÚBLICA (anon o publishable). Nunca la service_role.
# Vacío = atender alertas no exige sesión (modo borde / desarrollo).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# HU-17: si vale 1, las consultas de datos (eventos, alertas, FHIR) exigen la sesión
# del cuidador. Requiere SUPABASE_URL y SUPABASE_ANON_KEY. Vacío = consultas abiertas.
PROTEGER_LECTURAS=

# Orígenes CORS extra separados por coma (por ejemplo, la IP pública de un servidor).
CORS_ORIGINS=

# Regla de la puerta principal (PU-04). Valores por defecto: 22, 7 y 10.
PUERTA_HORA_NOCHE_INICIO=22
PUERTA_HORA_NOCHE_FIN=7
PUERTA_MINUTOS_MAX_ABIERTA=10

# ------------------------------------------------------------
# FRONTEND (React + Vite) - se incorporan al compilar el panel
# ------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/ws/alertas
# Mismos valores públicos que SUPABASE_URL y SUPABASE_ANON_KEY.
# Vacío = el panel no muestra el botón "Ingresar".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# SIMULADOR DE SENSORES (simulate_sensors.py)
# ------------------------------------------------------------
# Backend al que envía los datos. Debe usar la misma DOMOVIDA_API_KEY.
DOMOVIDA_API_URL=http://localhost:8000
